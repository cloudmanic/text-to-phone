# Port the HTTP server listens on.
PORT=8080

# Every request to POST /call must send this as access_token.
ACCESS_TOKEN=change-me

# Twilio account (1Password: Autumn / "Twilio Cloudmanic API Keys").
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Number the call comes from (the Options Cafe number).
TWILIO_FROM_NUMBER=+19517833868

# Number that gets called.
CALL_TO_NUMBER=+15555555555

# Voice Twilio reads with.
TWILIO_VOICE=Polly.Joanna
